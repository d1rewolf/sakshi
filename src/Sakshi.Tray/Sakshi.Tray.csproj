<Project Sdk="Microsoft.NET.Sdk">
  <!-- The same app on the GUI subsystem: sakshiw.exe starts the tray without a console window. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>sakshiw</AssemblyName>
    <RootNamespace>Sakshi.Tray</RootNamespace>
    <!-- The icon Windows shows for the exe: Explorer, the taskbar, and windows that set none of their own. -->
    <ApplicationIcon>../../packaging/sakshi.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Sakshi.App/Sakshi.App.csproj" />
  </ItemGroup>
</Project>
